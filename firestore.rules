rules_version = '2';

// Règles de sécurité de la base Firestore.
// Par défaut tout est interdit. On autorise seulement :
//  - chaque utilisateur à lire et modifier son propre profil ;
//  - tout le monde à lire les boutiques et les produits ;
//  - seul le propriétaire à créer, modifier ou supprimer sa boutique et ses produits ;
//  - un utilisateur connecté à passer une commande en son nom ;
//  - seuls l'acheteur et le vendeur à lire une commande ;
//  - seul le vendeur à changer le statut d'une commande.
// Déploiement : firebase deploy --only firestore:rules

service cloud.firestore {
  match /databases/{database}/documents {

    function isOwner(uid) {
      return request.auth != null && request.auth.uid == uid;
    }

    match /users/{uid} {
      allow read, write: if isOwner(uid);
    }

    // Le document de la boutique a le même identifiant que son propriétaire.
    match /shops/{uid} {
      allow read: if true;
      allow write: if isOwner(uid);
    }

    match /products/{productId} {
      allow read: if true;
      allow create: if isOwner(request.resource.data.ownerId)
                    && request.resource.data.price is int
                    && request.resource.data.price > 0;
      allow update, delete: if isOwner(resource.data.ownerId);
    }

    match /orders/{orderId} {
      // L'acheteur crée la commande pour lui-même, avec une quantité valide,
      // et elle commence toujours "en attente".
      allow create: if isOwner(request.resource.data.buyerId)
                    && request.resource.data.quantity is int
                    && request.resource.data.quantity > 0
                    && request.resource.data.status == 'pending';
      allow read: if isOwner(resource.data.buyerId) || isOwner(resource.data.sellerId);
      // Le vendeur peut seulement changer le champ status.
      allow update: if isOwner(resource.data.sellerId)
                    && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status']);
    }
  }
}
